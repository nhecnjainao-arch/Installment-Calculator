<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>SAR Installment Calculator</title>
<style>
body{font-family:Arial;margin:0;background:#f4f6fa;color:#172033}.wrap{max-width:1050px;margin:auto;padding:20px}
.card{background:white;border:1px solid #ddd;border-radius:14px;padding:18px;margin:14px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:700px){.grid{grid-template-columns:1fr}}
input,select,button{padding:10px;border:1px solid #bbb;border-radius:8px;font-size:15px}input,select{width:100%;box-sizing:border-box}
button{background:#3f51b5;color:white;border:0;cursor:pointer;margin:5px 3px 5px 0}.secondary{background:#e9edf5;color:#172033}
label{display:block;font-weight:bold;margin:10px 0 5px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.metric{background:#f7f8fb;padding:12px;border-radius:9px}.metric small{display:block;color:#667085}.metric b{font-size:18px}
table{width:100%;border-collapse:collapse;margin-top:10px}th,td{padding:9px;border-bottom:1px solid #ddd;text-align:right}th:first-child,td:first-child{text-align:left}
.note{font-size:13px;color:#667085;line-height:1.5}.warn{background:#fff7df;padding:10px;border-radius:8px;font-size:13px}
</style></head><body><div class="wrap">
<h1>SAR Installment & Borrowing Calculator</h1>
<p class="note">Use the actual profit rate shown by your financing provider. The 9- and 12-month rates below come from your screenshots.</p>

<div class="grid">
<div class="card"><h2>Main Calculator</h2>
<label>Purchase / Borrowed Amount (SAR)</label><input id="amt" type="number" value="5000" step=".01">
<label>Tenure (months)</label><select id="months"><option>2</option><option>3</option><option>4</option><option>6</option><option>8</option><option selected>9</option><option>12</option></select>
<label>Profit Rate (%)</label><input id="pr" type="number" value="10.31" step=".01">
<label>Processing Fee (%)</label><input id="fee" type="number" value=".51" step=".01">
<button onclick="calc()">Calculate</button><button class="secondary" onclick="base9()">9-month baseline</button><button class="secondary" onclick="base12()">12-month baseline</button>
<div class="metrics">
<div class="metric"><small>Profit</small><b id="p">SAR 0.00</b></div>
<div class="metric"><small>Processing</small><b id="f">SAR 0.00</b></div>
<div class="metric"><small>Total Extra</small><b id="x">SAR 0.00</b></div>
<div class="metric"><small>Total Payable</small><b id="t">SAR 0.00</b></div>
<div class="metric"><small>Monthly</small><b id="m">SAR 0.00</b></div>
<div class="metric"><small>Extra %</small><b id="xp">0.00%</b></div>
</div></div>

<div class="card"><h2>Late Payment</h2><div class="warn">Default is 0%. Enter a rate only if your actual agreement specifies a late-payment charge.</div>
<label>Amount Due (SAR)</label><input id="la" type="number" value="5000" step=".01">
<label>Late Charge Rate Per Day (%)</label><input id="lr" type="number" value="0" step=".01">
<table><thead><tr><th>Delay</th><th>Additional Charge</th><th>Total Due</th></tr></thead><tbody id="late"></tbody></table></div>
</div>

<div class="card"><h2>SAR 5,000 Scenario Comparison</h2>
<p class="note">Edit any profit rate to model a different offer. Processing fee defaults to 0.51% based on your screenshots.</p>
<table><thead><tr><th>Months</th><th>Profit %</th><th>Profit</th><th>Processing</th><th>Total Extra</th><th>Total Payable</th><th>Monthly</th></tr></thead>
<tbody id="sc"></tbody></table></div>

<div class="card"><h2>Your Actual Screenshot Baselines</h2>
<table><thead><tr><th>Plan</th><th>Original</th><th>Profit</th><th>Profit %</th><th>Processing</th><th>Total</th><th>Monthly</th></tr></thead>
<tbody>
<tr><td>9 months</td><td>6,798.00</td><td>700.86</td><td>10.31%</td><td>34.47</td><td>7,533.34</td><td>837.04</td></tr>
<tr><td>12 months</td><td>5,571.36</td><td>1,010.87</td><td>18.14%</td><td>29.03</td><td>6,611.27</td><td>550.94</td></tr>
</tbody></table>
<p class="note">Formula: Profit = Amount × Profit %. Processing = Amount × Processing %. Total = Amount + Profit + Processing. Monthly = Total ÷ months.</p></div>
</div>

<script>
const rates={2:0,3:0,4:null,6:null,8:null,9:10.31,12:18.14};
const money=n=>'SAR '+n.toLocaleString('en-SA',{minimumFractionDigits:2,maximumFractionDigits:2});
function calc(){let a=+amt.value||0,r=(+pr.value||0)/100,f=(+fee.value||0)/100,n=+months.value;
let p=a*r,q=a*f,x=p+q,t=a+x;document.querySelector('#p').textContent=money(p);document.querySelector('#f').textContent=money(q);document.querySelector('#x').textContent=money(x);document.querySelector('#t').textContent=money(t);document.querySelector('#m').textContent=money(t/n);document.querySelector('#xp').textContent=(a?x/a*100:0).toFixed(2)+'%';}
function base9(){months.value=9;pr.value=10.31;fee.value=.51;calc()}
function base12(){months.value=12;pr.value=18.14;fee.value=.51;calc()}
function lateCalc(){let a=+la.value||0,r=(+lr.value||0)/100;late.innerHTML=[1,3,7,14].map(d=>{let c=a*(Math.pow(1+r,d)-1);return '<tr><td>'+d+' day'+(d>1?'s':'')+'</td><td>'+money(c)+'</td><td>'+money(a+c)+'</td></tr>'}).join('')}
function scenarios(){let a=5000,q=a*.0051;sc.innerHTML=[2,3,4,6,8,9,12].map(n=>{let r=rates[n];return '<tr><td>'+n+'</td><td><input id="r'+n+'" type="number" '+(r===null?'':'value="'+r+'"')+' placeholder="Enter %" step=".01" onchange="scenarioUpdate()"></td><td id="p'+n+'">—</td><td>'+money(q)+'</td><td id="x'+n+'">—</td><td id="t'+n+'">—</td><td id="m'+n+'">—</td></tr>'}).join('');scenarioUpdate()}
function scenarioUpdate(){let a=5000,q=a*.0051;[2,3,4,6,8,9,12].forEach(n=>{let r=parseFloat(document.querySelector('#r'+n).value);if(isNaN(r)){['p','x','t','m'].forEach(k=>document.querySelector('#'+k+n).textContent='—');return}let p=a*r/100,x=p+q,t=a+x;document.querySelector('#p'+n).textContent=money(p);document.querySelector('#x'+n).textContent=money(x);document.querySelector('#t'+n).textContent=money(t);document.querySelector('#m'+n).textContent=money(t/n)})}
['amt','pr','fee','months'].forEach(id=>document.getElementById(id).addEventListener('input',calc));
['la','lr'].forEach(id=>document.getElementById(id).addEventListener('input',lateCalc));
calc();lateCalc();scenarios();
</script></body></html>
